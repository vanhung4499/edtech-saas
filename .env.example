# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database
# Runtime role (api, worker, isolation tests) — not superuser, not table owner,
# no BYPASSRLS, so RLS policies always apply.
DATABASE_URL=postgres://edtech_app:edtech_app@localhost:5432/edtech
# Owner role — drizzle-kit generate/migrate/studio, seed. Never used at runtime.
DATABASE_MIGRATE_URL=postgres://edtech:edtech@localhost:5432/edtech

# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=change-me-in-local-env
